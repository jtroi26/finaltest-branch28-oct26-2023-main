                <style>
                        .chat-container {
                                width: 300px;
                                margin: 20px auto;
                                border: 1px solid #ccc;
                                border-radius: 5px;
                                padding: 10px;
                        }

                        .chat-box {
                                height: 300px;
                                overflow-y: scroll;
                                border-bottom: 1px solid #ccc;
                                margin-bottom: 10px;
                                padding-bottom: 10px;
                        }

                        #user-input {
                                width: calc(100% - 70px);
                                padding: 5px;
                        }

                        button {
                                width: 60px;
                                padding: 5px;
                                margin-left: 10px;
                                cursor: pointer;
                        }

                        /* Custom CSS */
                        .custom-style {
                                color: white;
                                font-size: 15px;
                        }

                        .content-wrapper {
                                display: flex;
                                justify-content: center;
                                align-items: justify;
                                min-height: 80vh;
                                /* Centers the container vertically within the viewport */
                                background-color: #f5f5f5;
                                /* Optional: light background color to contrast with the white box */
                        }

                        .centered-container {
                                background-color: #fff;
                                /* White background for the inner div */
                                padding: 20px;
                                /* Padding inside the box */
                                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                                /* Drop shadow for the outer container */
                                border-radius: 8px;
                                /* Optional: rounded corners for a smoother look */
                                max-width: 600px;
                                /* Optional: limit width for better readability */
                                text-align: justify;
                                /* Center text inside the container */
                        }

                        .centered-container p {
                                font-size: 18px;
                                /* Adjust this value to make the text larger or smaller */
                                line-height: 1.6;
                                /* Optional: Improve readability by increasing line height */
                        }
                </style>
        </head>

